{
  "experiment": {
    "name": "edsp_repro"
  },
  "bo": {
    "n_trials": 50,
    "sampler": "tpe"
  },
  "final_policies": 6,
  "validation": {
    "n_cases": 100,
    "cp_time_limit": 60,
    "range_jobs": [5, 15],
    "range_machines": [4, 13],
    "range_op_per_job": [4, 9],
    "max_processing": 25
  },
  "train": {
    "n_instances": 100
  },
  "ppo_fixed": {
    "gamma": 1,
    "eps_clip": 0.2,
    "k_epochs": 3
  },
  "search_space": {
    "max_episodes": [10000, 15000],
    "train_freq": [10, 100],
    "new_freq": [1, 3],
    "mask_option": [0, 1],
    "sel_k": [1, 3],
    "batch_size": [64, 128, 256],
    "lr": [0.0001, 0.001],
    "hidden_channels": [32, 64, 128],
    "num_layers": [1, 2],
    "heads": 1,
    "j_min": [5, 9],
    "j_max": [10, 15],
    "m_min": [4, 7],
    "m_max": [9, 13],
    "op_max": [5, 9],
    "max_processing": [8, 25]
  },
  "paths": {
    "save_root": "save",
    "results_root": "results"
  },
  "test": {
    "datasets": [
      {"name": "edata",  "path": "data/data_test/edata"},
      {"name": "rdata",  "path": "data/data_test/rdata"},
      {"name": "vdata",  "path": "data/data_test/vdata"},
      {"name": "mk",     "path": "data/data_test/Mk"},
      {"name": "10x10",  "path": "data/data_test/1010"},
      {"name": "20x5",   "path": "data/data_test/2005"},
      {"name": "20x10",  "path": "data/data_test/2010"},
      {"name": "20x20",  "path": "data/data_test/2020"},
      {"name": "20x30",  "path": "data/data_test/2030"},
      {"name": "30x10",  "path": "data/data_test/3010"},
      {"name": "40x10",  "path": "data/data_test/4010"},
      {"name": "50x10",  "path": "data/data_test/5010"},
      {"name": "100x10", "path": "data/data_test/10010"},
      {"name": "200x10", "path": "data/data_test/20010"}
    ]
  }
}
